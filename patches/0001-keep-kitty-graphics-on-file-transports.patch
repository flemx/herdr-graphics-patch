+/// Ghostty reads Kitty `t=t` files only from a temporary directory and checks the
+/// file's resolved path, so `/tmp` (really `/private/tmp`) never qualifies on macOS.
+/// The per-user temporary directory is what macOS hands GUI terminals as `TMPDIR`.
+pub(crate) fn kitty_temporary_file_root() -> PathBuf {
+    darwin_user_temporary_directory().unwrap_or_else(|| PathBuf::from("/tmp"))
+}
+
+fn darwin_user_temporary_directory() -> Option<PathBuf> {
+    let mut buffer = vec![0u8; libc::PATH_MAX as usize];
+    // SAFETY: the buffer is writable for the length passed, and confstr writes at most
+    // that many bytes including the terminating NUL.
+    let needed = unsafe {
+        libc::confstr(
+            libc::_CS_DARWIN_USER_TEMP_DIR,
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+        )
+    };
+    if needed == 0 || needed > buffer.len() {
+        return None;
+    }
+    buffer.truncate(needed - 1);
+    let path = PathBuf::from(OsStr::from_bytes(&buffer));
+    path.is_absolute().then_some(path)
+}
